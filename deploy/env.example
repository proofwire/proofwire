# Copy to deploy/.env and edit. setup.sh does the copy for you on first run.
# .env is git-ignored; keep it that way.

# The hostname this node answers on. Its DNS A (and AAAA, if you have IPv6)
# record must point at this server before Let's Encrypt can issue a certificate.
PROOFWIRE_DOMAIN=witness.example.com

# Your email, for Let's Encrypt expiry notices. Or "internal" for a
# self-signed certificate, to try the stack before DNS is ready.
PROOFWIRE_TLS=you@example.com

# 1: witness-only node (co-signing, its key and health checks, nothing else).
# 0: full hub (console, log ingest, policies, approvals). Run bootstrap after.
PROOFWIRE_WITNESS_ONLY=1

# Where the witness journal lives: every signature the witness gives, kept
# outside the database. After a restore from backup the witness catches up
# from it instead of forgetting what it signed. Leave unset for its own Docker
# volume (same disk as the database), or better, an absolute path on a
# separately attached disk, e.g. a cloud block volume mounted at /mnt/journal:
# PROOFWIRE_JOURNAL_DIR=/mnt/journal/proofwire

# Snapshot schedule inside the node. Copy them off the server as well.
PROOFWIRE_BACKUP_HOURS=6
PROOFWIRE_BACKUP_KEEP=28
