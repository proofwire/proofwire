node_modules/
*.log
.DS_Store

# A Deedwrit log's signing key and commitment salts never get committed.
# Entries and checkpoints are safe — and worth committing.
**/.deedwrit/key.pem
**/.deedwrit/salts.jsonl
# What `dw hook` keeps between one event and the next. Local state, not evidence.
**/.deedwrit/hook-pending.json
**/.deedwrit/hook.lock
# Where an appender left off: derived from the entries, rebuilt if it disagrees.
**/.deedwrit/append-state.json
.deedwrit-witness/
# The same, under the project's earlier names. Still private.
**/.vouchwell/key.pem
**/.vouchwell/salts.jsonl
.vouchwell-witness/
**/.proofwire/key.pem
**/.proofwire/salts.jsonl
.proofwire-witness/
*.bundle.json
# The website loads this one: the sample evidence its verifier checks. Kept on purpose.
!site/sample.bundle.json

# Hub database and its SQLite sidecars.
data/
*.db
*.db-wal
*.db-shm

# Secrets that must never reach a public repo, whatever they are called.
.env
.env.*
*.pem
*.key
.npmrc
credentials.json
*.sqlite
*.sqlite3

# Local tooling. Except the project's Claude Code hooks, which record every
# action an agent takes while working on Deedwrit (see evidence/README.md);
# the log they write stays in .claude/deedwrit-log/, which is not committed.
.claude/*
!.claude/settings.json
!.claude/deedwrit.config.json
!.claude/deedwrit.policy.json

# Python SDK
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
sdk/python/dist/
sdk/python/build/

# Business planning stays out of this public repository. Keep it in private/
# (or a private repository); nothing in it is ever committed here.
private/
BUSINESS.md
