{
  "name": "vouchwell-monorepo",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Vouchwell — tamper-evident, independently verifiable receipts for AI agent actions.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "packages/proxy",
    "packages/cli",
    "packages/dashboard",
    "packages/server"
  ],
  "scripts": {
    "test": "node --no-warnings=ExperimentalWarning --test",
    "demo": "node examples/demo.js",
    "vw": "node packages/cli/src/bin.js",
    "evidence": "node packages/cli/src/bin.js hook evidence evidence --config .claude/vouchwell.config.json",
    "hub": "node --no-warnings=ExperimentalWarning packages/server/src/bin.js",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
    "bump": "node scripts/bump.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vouchwell/vouchwell.git"
  },
  "homepage": "https://github.com/vouchwell/vouchwell#readme",
  "bugs": {
    "url": "https://github.com/vouchwell/vouchwell/issues"
  }
}
