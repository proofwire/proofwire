{
  "name": "vouchwell-monorepo",
  "version": "0.5.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "vouchwell-monorepo",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/core",
        "packages/proxy",
        "packages/cli",
        "packages/dashboard",
        "packages/server"
      ],
      "engines": {
        "node": ">=20.11"
      }
    },
    "node_modules/@vouchwell/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@vouchwell/dashboard": {
      "resolved": "packages/dashboard",
      "link": true
    },
    "node_modules/@vouchwell/proxy": {
      "resolved": "packages/proxy",
      "link": true
    },
    "node_modules/@vouchwell/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/vouchwell": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "vouchwell",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@vouchwell/core": "0.5.0",
        "@vouchwell/proxy": "0.5.0"
      },
      "bin": {
        "vouchwell": "src/bin.js",
        "vw": "src/bin.js"
      },
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/core": {
      "name": "@vouchwell/core",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/dashboard": {
      "name": "@vouchwell/dashboard",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@vouchwell/core": "0.5.0"
      },
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/proxy": {
      "name": "@vouchwell/proxy",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@vouchwell/core": "0.5.0"
      },
      "engines": {
        "node": ">=20.11"
      }
    },
    "packages/server": {
      "name": "@vouchwell/server",
      "version": "0.5.0",
      "license": "Apache-2.0",
      "dependencies": {
        "@vouchwell/core": "0.5.0"
      },
      "bin": {
        "vouchwell-hub": "src/bin.js"
      },
      "engines": {
        "node": ">=22.13"
      }
    }
  }
}
